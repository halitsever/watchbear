# Local dev server. Uses wss when the NestJS server has mkcert certs (see
# apps/server/certs). If you don't set up certs, change this to http://localhost:3000.
VITE_SERVER_URL=https://localhost:3000

# Google OAuth Web client ID. Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=934864780263-ojf7ujhtd7gcd531s4srlu6qoskr2vdh.apps.googleusercontent.com

# Auth endpoint (login). Always the official service, independent of the room
# server the user picks in settings. In dev, point it at the local server.
VITE_AUTH_URL=https://localhost:3000
