# Copy to .env for local development (.env is gitignored).

# Postgres. Either set a single DATABASE_URL or the discrete PG* vars below.
DATABASE_URL=postgres://watchbear:watchbear@localhost:5432/watchbear
# PGHOST=localhost
# PGPORT=5432
# PGUSER=watchbear
# PGPASSWORD=watchbear
# PGDATABASE=watchbear

# Google OAuth Web client ID (same value used by the extension). No secret needed.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret for signing Watchbear session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Existing server config (optional).
# PORT=3000
# CORS_ORIGINS=https://watchbear.example.com
