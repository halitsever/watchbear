# Copy to .env for local development (.env is gitignored).

# Postgres. Either set a single DATABASE_URL or the discrete PG* vars below.
DATABASE_URL=postgres://watchbear:watchbear@localhost:5432/watchbear
# PGHOST=localhost
# PGPORT=5432
# PGUSER=watchbear
# PGPASSWORD=watchbear
# PGDATABASE=watchbear

# Google OAuth Web client ID (same value used by the extension). No secret needed.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret for signing Watchbear session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Require login to pick a name/color/avatar. Set false during an extension rollout
# so existing guests keep their chosen names, then flip to true. Default: true.
ENFORCE_LOGIN_CUSTOMIZE=true

# Require login to join a room at all. Set false to allow guest joins
# (self-hosted deployments or emergency rollback). Default: true.
ENFORCE_LOGIN_JOIN=true

# Existing server config (optional).
# PORT=3000
# CORS_ORIGINS=https://watchbear.example.com
