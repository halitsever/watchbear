# Deployed server URL for production builds. Should be https (socket.io upgrades
# it to wss automatically). Leave unset to fall back to http://localhost:3000.
VITE_SERVER_URL=https://watchbear-server.deepfeld.com

# Google OAuth Web client ID. Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=934864780263-ojf7ujhtd7gcd531s4srlu6qoskr2vdh.apps.googleusercontent.com

# Auth endpoint (login). Always the official service, independent of the room
# server the user picks in settings.
VITE_AUTH_URL=https://watchbear-server.deepfeld.com
